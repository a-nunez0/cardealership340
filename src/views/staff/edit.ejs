<%- include("../partials/header") %>
<a class="back" href="/staff/inventory">← Manage inventory</a>
<section class="panel form-panel">
  <h1>Edit vehicle</h1>
  <p><%= vehicle.year %> <%= vehicle.make %> <%= vehicle.model %> · <%= vehicle.stock_number %></p>
  <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
  <form method="post" action="/staff/inventory/<%= vehicle.id %>/edit">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="price">Price in USD</label>
    <input id="price" name="price" type="number" min="0.01" max="99999999.99" step="0.01" value="<%= values.price %>" required>
    <label for="description">Description</label>
    <textarea id="description" name="description" rows="5" maxlength="2000" required><%= values.description %></textarea>
    <label for="availability">Availability</label>
    <select id="availability" name="availability" required>
      <% for (const option of availabilityOptions) { %>
        <option value="<%= option %>" <% if (values.availability === option) { %>selected<% } %>><%= option %></option>
      <% } %>
    </select>
    <button class="button">Save changes</button>
  </form>
  <% if (user.role === "owner") { %>
    <details class="delete">
      <summary>Delete vehicle</summary>
      <p>This permanently removes the listing and its photos.</p>
      <form method="post" action="/staff/inventory/<%= vehicle.id %>/delete">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="button danger">Permanently delete vehicle</button>
      </form>
    </details>
  <% } %>
</section>
<%- include("../partials/footer") %>
